# Server-only credentials. Never use VITE_ prefixes for these values.
COMFY_API_KEY=
# Leave blank for default Comfy Cloud; alternatively use a Developer Platform
# deployment URL or a local compatible v2 API proxy, not raw ComfyUI port 8188.
COMFY_BASE_URL=
COMFY_SDXL_CHECKPOINT=sd_xl_base_1.0.safetensors
# Set a randomly generated secret of at least 24 characters to enable rendering.
TAKE7_ACCESS_TOKEN=
# Video remains disabled until its graph and models are validated on your engine.
TAKE7_ENABLE_LTX=false
# Use a persistent writable absolute path in production.
TAKE7_DATA_DIR=.data
# Set to the exact public origin for deployment, e.g. https://take7.example.com
TAKE7_PUBLIC_ORIGIN=
